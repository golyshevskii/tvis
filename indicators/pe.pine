//@version=6

//
// tvis: P/E History & Forward Estimate
//  - Trailing P/E:  close / TTM EPS            (real, from request.financial)
//  - Forward P/E:   close / proxy EPS          (APPROXIMATE - see notes below)
//  - Historical context: running mean + 1σ/2σ bands + live z-score
//
//  NOTES / LIMITATIONS:
//   * Works on individual stock tickers that have fundamental data.
//     Indices, forex, and crypto will show n/a.
//   * Forward P/E is a PROXY. TradingView does not expose a true forward
//     12-month consensus EPS to Pine. Two proxy methods are offered:
//        - "Reported-quarter estimate ×4 (proxy)": the latest estimate attached
//          to a reported quarter, annualized. It is not an NTM forecast.
//        - "Growth assumption":     trailing TTM EPS grown by an assumed rate.
//   * Fundamental history on TradingView is limited (often a handful of years),
//     so the "all history" mean only spans the available EPS data.
//   * Unsupported symbols and unavailable data produce n/a.
//   * Verified on regular-session daily/weekly bars with dividend adjustment off,
//     native quote currency, and ordinary share/unit prices. Chart currency
//     overrides, minor-unit quotes, synthetic charts, extended sessions, and
//     other timeframes are unverified.

indicator("tvis: P/E History & Forward Estimate", precision=2)

// @contract pe-ratio:start
peRatio(float price, float eps) =>
    not na(price) and price > 0 and not na(eps) and eps > 0 ? price / eps : na

growthScenarioEPS(float eps, float growthPercent) =>
    float scenario = not na(eps) and eps > 0 ? eps * (1 + growthPercent / 100) : na
    not na(scenario) and scenario > 0 ? scenario : na

analystProxyEPS(float reportedQuarterEstimate) =>
    not na(reportedQuarterEstimate) and reportedQuarterEstimate > 0 ? reportedQuarterEstimate * 4 : na
// @contract pe-ratio:end

// @contract pe-statistics:start
statsAdd(int count, float mean, float m2, float value) =>
    int nextCount = count
    float nextMean = mean
    float nextM2 = m2
    if not na(value)
        nextCount += 1
        float delta = value - nextMean
        nextMean += delta / nextCount
        nextM2 += delta * (value - nextMean)
    [nextCount, nextMean, nextM2]

statsMerge(int leftCount, float leftMean, float leftM2, int rightCount, float rightMean, float rightM2) =>
    int count = leftCount + rightCount
    float mean = leftCount == 0 ? rightMean : rightCount == 0 ? leftMean : leftMean + (rightMean - leftMean) * rightCount / count
    float delta = rightMean - leftMean
    float m2 = leftCount == 0 ? rightM2 : rightCount == 0 ? leftM2 : leftM2 + rightM2 + delta * delta * leftCount * rightCount / count
    [count, mean, m2]

statsStackPush(array<float> values, array<int> counts, array<float> means, array<float> m2s, float value) =>
    int count = array.size(counts) > 0 ? array.last(counts) : 0
    float mean = array.size(means) > 0 ? array.last(means) : 0.0
    float m2 = array.size(m2s) > 0 ? array.last(m2s) : 0.0
    [nextCount, nextMean, nextM2] = statsAdd(count, mean, m2, value)
    array.push(values, value)
    array.push(counts, nextCount)
    array.push(means, nextMean)
    array.push(m2s, nextM2)

statsStackPop(array<float> values, array<int> counts, array<float> means, array<float> m2s) =>
    float value = array.pop(values)
    array.pop(counts)
    array.pop(means)
    array.pop(m2s)
    value

statsQueueUpdate(array<float> inValues, array<int> inCounts, array<float> inMeans, array<float> inM2s, array<float> outValues, array<int> outCounts, array<float> outMeans, array<float> outM2s, int bars, int window, float value) =>
    int nextBars = bars
    if nextBars == window
        if array.size(outValues) == 0
            while array.size(inValues) > 0
                float transferred = statsStackPop(inValues, inCounts, inMeans, inM2s)
                statsStackPush(outValues, outCounts, outMeans, outM2s, transferred)
        statsStackPop(outValues, outCounts, outMeans, outM2s)
        nextBars -= 1
    statsStackPush(inValues, inCounts, inMeans, inM2s, value)
    nextBars += 1
    int outCount = array.size(outCounts) > 0 ? array.last(outCounts) : 0
    float outMean = array.size(outMeans) > 0 ? array.last(outMeans) : 0.0
    float outM2 = array.size(outM2s) > 0 ? array.last(outM2s) : 0.0
    int inCount = array.size(inCounts) > 0 ? array.last(inCounts) : 0
    float inMean = array.size(inMeans) > 0 ? array.last(inMeans) : 0.0
    float inM2 = array.size(inM2s) > 0 ? array.last(inM2s) : 0.0
    [count, mean, m2] = statsMerge(outCount, outMean, outM2, inCount, inMean, inM2)
    [nextBars, count, mean, m2]

statsMean(int count, float mean) =>
    count > 0 ? mean : na

statsSigma(int count, float m2) =>
    count > 1 ? math.sqrt(math.max(m2 / count, 0.0)) : na

statsZ(float value, float mean, float sigma) =>
    not na(value) and not na(mean) and not na(sigma) and sigma > 0 ? (value - mean) / sigma : na

statsVerdict(float z) =>
    na(z) ? "n/a" : z > 2 ? "Very rich" : z > 1 ? "Rich" : z < -2 ? "Very cheap" : z < -1 ? "Cheap" : "Normal"
// @contract pe-statistics:end

// Inputs
epsId     = input.string("EARNINGS_PER_SHARE_DILUTED", "Trailing EPS source",
             options=["EARNINGS_PER_SHARE_DILUTED", "EARNINGS_PER_SHARE_BASIC"])
showFwd   = input.bool(true, "Show Forward P/E")
fwdMode   = input.string("Reported-quarter estimate ×4 (proxy)", "Forward EPS method",
             options=["Reported-quarter estimate ×4 (proxy)", "Growth assumption"])
growthPct = input.float(8.0, "Assumed annual EPS growth % (growth mode)",
             minval=-50, maxval=300)
lbMode    = input.string("All history", "Average window",
             options=["All history", "Rolling lookback"])
lookback  = input.int(252, "Rolling lookback (bars)", minval=10, maxval=5000)
showBands = input.bool(true, "Show ±1σ / ±2σ bands")
showTable = input.bool(true, "Show info table")

// Trailing P/E
epsTTM = request.financial(syminfo.tickerid, epsId, "TTM", gaps=barmerge.gaps_off, ignore_invalid_symbol=true, currency=syminfo.currency)
pe = peRatio(close, epsTTM)
plot(pe, "Trailing P/E", color=color.new(#2962FF, 0), linewidth=2)

// Forward P/E (proxy)
float estQ = na
if showFwd and fwdMode == "Reported-quarter estimate ×4 (proxy)"
    estQ := request.earnings(syminfo.tickerid, earnings.estimate, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true, currency=syminfo.currency)
scenarioEPS = growthScenarioEPS(epsTTM, growthPct)
analystEPS = analystProxyEPS(estQ)
fwdEPS = fwdMode == "Growth assumption" ? scenarioEPS : analystEPS
fwdPE = showFwd ? peRatio(close, fwdEPS) : na
plot(fwdPE, "Forward P/E", color=color.new(#FF6D00, 0), linewidth=2)

// Historical mean & dispersion
var int allCount = 0
var float allMean = 0.0
var float allM2 = 0.0
[nextAllCount, nextAllMean, nextAllM2] = statsAdd(allCount, allMean, allM2, pe)
allCount := nextAllCount
allMean := nextAllMean
allM2 := nextAllM2

var array<float> rollingInValues = array.new<float>()
var array<int> rollingInCounts = array.new<int>()
var array<float> rollingInMeans = array.new<float>()
var array<float> rollingInM2s = array.new<float>()
var array<float> rollingOutValues = array.new<float>()
var array<int> rollingOutCounts = array.new<int>()
var array<float> rollingOutMeans = array.new<float>()
var array<float> rollingOutM2s = array.new<float>()
var int rollingBars = 0
[nextRollingBars, rollingCount, rollingMean, rollingM2] = statsQueueUpdate(rollingInValues, rollingInCounts, rollingInMeans, rollingInM2s, rollingOutValues, rollingOutCounts, rollingOutMeans, rollingOutM2s, rollingBars, lookback, pe)
rollingBars := nextRollingBars

bool allHistory = lbMode == "All history"
int sampleCount = allHistory ? allCount : rollingCount
float sampleMean = allHistory ? allMean : rollingMean
float sampleM2 = allHistory ? allM2 : rollingM2
float meanPE = statsMean(sampleCount, sampleMean)
float sdPE = statsSigma(sampleCount, sampleM2)

plot(meanPE, "Mean P/E", color=color.new(color.gray, 0), linewidth=1)

u1 = meanPE + sdPE
l1 = meanPE - sdPE
u2 = meanPE + 2 * sdPE
l2 = meanPE - 2 * sdPE

pu1 = plot(showBands ? u1 : na, "+1σ", color=color.new(color.gray, 55))
pl1 = plot(showBands ? l1 : na, "-1σ", color=color.new(color.gray, 55))
fill(pu1, pl1, color=color.new(color.gray, 90), title="±1σ zone")
plot(showBands ? u2 : na, "+2σ", color=color.new(color.red, 65))
plot(showBands ? l2 : na, "-2σ", color=color.new(color.green, 65))

// Info table
posInput  = input.string("Top right", "Table position",
             options=["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"],
             group="Table")
sizeInput = input.string("Normal", "Table text size",
             options=["Tiny", "Small", "Normal", "Large"], group="Table")

tablePos = switch posInput
    "Top left"     => position.top_left
    "Bottom right" => position.bottom_right
    "Bottom left"  => position.bottom_left
    "Middle right" => position.middle_right
    => position.top_right

txtSize = switch sizeInput
    "Tiny"  => size.tiny
    "Small" => size.small
    "Large" => size.large
    => size.normal

zscore = statsZ(pe, meanPE, sdPE)

// Plain-English read of where current P/E sits vs its own history
verdict = statsVerdict(zscore)
vColor  = na(zscore) ? color.gray : zscore > 1 ? color.red : zscore < -1 ? color.green : color.gray

var table t = table.new(tablePos, 2, 6, border_width=1, frame_width=1,
     frame_color=color.new(color.gray, 40))
if showTable and barstate.islast
    hdrBg = color.new(color.gray, 10)   // solid-ish header so it pops on dark charts
    rowBg = color.new(color.gray, 85)   // faint fill behind data rows
    table.cell(t, 0, 0, "P/E vs history", text_color=color.white, bgcolor=hdrBg, text_size=txtSize)
    table.cell(t, 1, 0, "",               text_color=color.white, bgcolor=hdrBg, text_size=txtSize)
    table.cell(t, 0, 1, "Trailing P/E", text_color=color.gray, bgcolor=rowBg, text_size=txtSize)
    table.cell(t, 1, 1, na(pe) ? "n/a" : str.tostring(pe, "#.##"), text_color=#2962FF, bgcolor=rowBg, text_size=txtSize)
    table.cell(t, 0, 2, "Forward P/E", text_color=color.gray, bgcolor=rowBg, text_size=txtSize)
    table.cell(t, 1, 2, showFwd ? (na(fwdPE) ? "n/a" : str.tostring(fwdPE, "#.##")) : "Off", text_color=#FF6D00, bgcolor=rowBg, text_size=txtSize)
    table.cell(t, 0, 3, "Mean P/E", text_color=color.gray, bgcolor=rowBg, text_size=txtSize)
    table.cell(t, 1, 3, na(meanPE) ? "n/a" : str.tostring(meanPE, "#.##"), text_color=color.gray, bgcolor=rowBg, text_size=txtSize)
    table.cell(t, 0, 4, "Z-score", text_color=color.gray, bgcolor=rowBg, text_size=txtSize)
    table.cell(t, 1, 4, na(zscore) ? "n/a" : str.tostring(zscore, "0.00") + " sd", text_color=vColor, bgcolor=rowBg, text_size=txtSize)
    table.cell(t, 0, 5, "Position", text_color=color.gray, bgcolor=rowBg, text_size=txtSize)
    table.cell(t, 1, 5, verdict, text_color=vColor, bgcolor=rowBg, text_size=txtSize)
